"""Bazel module for rust-ibverbs - RDMA InfiniBand verbs bindings for Rust"""

module(
    name = "rust-ibverbs",
    version = "0.9.2",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.68.1")

# rust_bindgen for generating FFI bindings
bazel_dep(name = "rules_rust_bindgen", version = "0.68.1")

# Hermetic prebuilt LLVM distribution, used only to provide `clang` and `libclang` to the bindgen
# toolchain below (the default bindgen toolchain compiles LLVM from source, which is both slow and
# does not build with newer host compilers)
bazel_dep(name = "toolchains_llvm", version = "1.5.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "17.0.6")
use_repo(llvm, "llvm_toolchain_llvm")

# Configure rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Register the bindgen toolchain backed by the prebuilt LLVM distribution (see //:bindgen_toolchain)
register_toolchains("//:bindgen_toolchain")

# Set up crates repository for dependencies (nix, serde, thiserror)
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.spec(
    package = "nix",
    version = "0.31.3",
    default_features = False,
    features = ["fs", "poll"],
)
crate.spec(
    package = "thiserror",
    version = "2.0",
)
crate.from_specs()
use_repo(crate, "crates")

# Fetch rdma-core source for headers
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
# Keep this in sync with the version of the vendored rdma-core submodule the Cargo build binds
# against (see ibverbs-sys/vendor/rdma-core); the crate reads fields and enum variants that older
# headers do not have.
http_archive(
    name = "rdma_core",
    urls = ["https://github.com/linux-rdma/rdma-core/archive/refs/tags/v63.0.tar.gz"],
    strip_prefix = "rdma-core-63.0",
    sha256 = "3a1808f419bad566b33d844b532dd9c899500c7e008615f7a1c0d0ca26b4f1be",
    build_file = "//:third_party/rdma_core.BUILD.bazel",
)

